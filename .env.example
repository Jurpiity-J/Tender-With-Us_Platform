# Required for the Next.js web app. Supply values from your own Supabase project.
# This is a template: do not commit real keys or a populated .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Supabase Edge Function scan-documents has separate server-side secrets:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, VIRUSTOTAL_API_KEY,
# SCANNER_INTERNAL_TOKEN. Configure these in the Supabase function environment,
# never in NEXT_PUBLIC_ variables or browser-delivered code.
